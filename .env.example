# Server Port
PORT=3000

# SQLite Database File Path (use :memory: for in-memory DB)
DB_PATH=./webhook_engine.db

# HMAC SHA-256 Secret Key for Webhook Signatures
WEBHOOK_SECRET=whsec_nestack_secret_key_2026

# Outgoing HTTP request timeout in milliseconds
HTTP_TIMEOUT_MS=5000

# Background Worker polling interval in milliseconds
POLL_INTERVAL_MS=1000
